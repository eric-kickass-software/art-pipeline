# Git is for the tool and its workflow (code, specs, docs) only. Everything it generates stays local: approved
# art is exported into the game project, the rest can be thrown away.
/sprites/
/textures/
/kit/
/work/
/.venv/
__pycache__/

# Archived sets, candidates and spec history (delete by hand when sure)
/archive/

# Throwaway test sets
/specs/dungeon_sets/zz_*.json

# Materials library downloads (re-downloadable; the material JSON files are in git)
/library/cache/
/.claude/

# Machine-specific settings (hdart/config.py)
/config.local.toml
# The store's cross-process locks beside each JSON file (hdart/store.py); uv.lock is not one of them
*.json.lock
